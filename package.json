{
  "name": "msgpilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MsgPilot Monorepo - WhatsApp Automation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm --prefix apps/api run build && npm --prefix apps/api run start:dev",
    "web:dev": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "dev:clean": "set NODE_OPTIONS=--no-deprecation && concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "build:shared": "npm --prefix packages/shared run build",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
