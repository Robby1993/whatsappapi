{
  "name": "msgpilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MsgPilot Monorepo - WhatsApp Automation",
  "workspaces": [
    "api",
    "web",
    "shared"
  ],
  "scripts": {
    "api:dev": "npm --prefix api run start:dev",
    "web:dev": "npm --prefix web run dev",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "build:shared": "npm --prefix shared run build",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
